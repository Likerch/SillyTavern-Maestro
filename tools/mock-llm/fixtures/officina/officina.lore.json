        {
            "type": "character",
            "about": "Ирма Вельс",
            "title": "Ирма Вельс",
            "fields": [
                {
                    "id": "name",
                    "value": "Ирма Вельс"
                },
                {
                    "id": "aliases",
                    "value": "госпожа Вельс, старшая фонарщица"
                },
                {
                    "id": "role",
                    "value": "старшая фонарщица гильдии, хранительница договора с туманом"
                },
                {
                    "id": "age",
                    "value": "52"
                },
                {
                    "id": "appearance",
                    "value": "Высокая, сухая, седина у висков; серый плащ гильдии и перчатки, которых она не снимает: ладони в старых ожогах."
                },
                {
                    "id": "personality",
                    "value": "Вежлива, холодна, точна в словах. Не повышает голос — достаточно паузы. Ценит порядок выше людей и знает, что это грех."
                },
                {
                    "id": "background",
                    "value": "Учила Эдвина Морра ремеслу. Десять лет назад отдала туману младшего брата, чтобы гильдия не расторгла договор."
                },
                {
                    "id": "relationships",
                    "value": "Отец Сильвестр — давний противник. Тобиас Крейн берёт у гильдии деньги и молчит."
                },
                {
                    "id": "speech",
                    "value": "Короткие фразы, обращение на «вы», говорит о страшном тоном прогноза погоды."
                },
                {
                    "id": "goals",
                    "value": "Не дать маяку зажечь большой огонь до весны; понять, кто вызвал нового смотрителя."
                }
            ],
            "keys": [
                "фонарщица",
                "госпожа Вельс"
            ],
            "constant": false
        },
